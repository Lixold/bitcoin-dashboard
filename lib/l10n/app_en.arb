      "topOne": { "type": "String" },
      "topThree": { "type": "String" }
    }
  },
  "networkPoolsInsightCritical": "The largest pool holds {topOne} %, the three largest {topThree} % together — at this scale a single operator or a small group can withhold blocks and decide the order of transactions.",
